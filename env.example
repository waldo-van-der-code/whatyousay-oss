# Copy this to .env and fill in your values. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# Groq: Whisper transcription + LLM cleanup/translation/summary (console.groq.com)
GROQ_API_KEY=

# Resend: magic-link login emails (resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
# Quoted: start.sh sources this file with bash, where an unquoted < is a redirect.
EMAIL_FROM="WhatYouSay <hello@your-domain.example>"

# Encrypts WhatsApp credentials and Signal keys at rest. Required in production.
# Generate with: openssl rand -hex 32. Losing it unlinks every WhatsApp session.
DB_ENCRYPTION_KEY=

# Public URL of your instance, no trailing slash. Used in login links, in the footer of
# every transcript reply, and to register the Telegram webhook.
BASE_URL=https://whatyousay.your-domain.example

# Who may sign in: comma-separated emails, or * for open signup (anyone can then link
# a WhatsApp account and use your Groq quota). ADMIN_EMAIL is always allowed.
# Unset in production = nobody except ADMIN_EMAIL can sign in.
ALLOWED_EMAILS=you@your-domain.example

# ── Optional ────────────────────────────────────────────────────────────────
# Development only: seeds a local encryption key when DB_ENCRYPTION_KEY is unset.
# Production ignores it and requires DB_ENCRYPTION_KEY.
# SESSION_SECRET=

# Port and bind address. Keep 127.0.0.1 behind a reverse proxy.
PORT=3000
# HOST=127.0.0.1

# SQLite file location (default: ./whatyousay.db in the working directory)
# DB_PATH=/path/to/whatyousay.db

# Enables /admin (user list + delete) for this one login email, and may always sign in
# ADMIN_EMAIL=you@your-domain.example

# Ordered CSV fallback chain for the LLM steps. Falls back to the next model only when
# the current one is confirmed retired (HTTP 404).
# GROQ_LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Single-model override, replaces the whole chain if set.
# GROQ_LLM_MODEL=openai/gpt-oss-120b

# LOG_LEVEL=info
# Plain-http testing only: drop the Secure flag from cookies. Ignored when NODE_ENV=production.
# ALLOW_INSECURE_COOKIES=true
# Dev only: print magic-link URLs to the console. NEVER set in production.
# LOG_MAGIC_LINKS=true

# ── Optional: Telegram transcription bot ────────────────────────────────────
# Create via @BotFather, then disable Group Privacy (/setprivacy → Disable) so it sees group messages.
# TELEGRAM_WHATYOUSAY_BOT_TOKEN=
# Secret Telegram echoes on every webhook call. Generate: openssl rand -hex 32
# If unset, a secret is derived from the bot token. The webhook is only registered when BASE_URL is set.
# TELEGRAM_WEBHOOK_SECRET=

# ── Optional: Telegram ops alerts (both must be set) ────────────────────────
# Fires on failed transcriptions, degraded pipeline runs and retired models.
# Only metadata is sent: no transcript text, no contact names, no full phone numbers.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Forum topic id, if the chat is a supergroup with topics
# TELEGRAM_THREAD_ID=
