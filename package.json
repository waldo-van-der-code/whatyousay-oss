{
  "name": "whatyousay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "bash start.sh",
    "test:pipeline": "tsx src/test-pipeline.ts",
    "test:eval:install": "npx playwright install chromium",
    "test:eval": "playwright test",
    "test:eval:smoke": "npx tsx evals/smoke.ts",
    "test:eval:retry": "npx tsx evals/wa-retry.ts",
    "test:eval:resilience": "npx tsx evals/pipeline-resilience.ts",
    "test:eval:readonly": "playwright test --grep @readonly",
    "test:eval:pipeline": "npx tsx evals/pipeline-evals.ts",
    "check": "tsc --noEmit && tsx evals/env-example.ts && tsx evals/wa-retry.ts && tsx evals/pipeline-resilience.ts && tsx evals/security.ts && tsx evals/shutdown.ts && tsx evals/privacy-alerts.ts",
    "test:eval:security": "npx tsx evals/security.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "grammy": "^1.0.0",
    "groq-sdk": "^0.3.3",
    "pino": "^9.1.0",
    "qrcode": "^1.5.3",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@6.7.24": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT",
  "description": "WhatsApp voice notes to text replies, without keeping the transcripts."
}
